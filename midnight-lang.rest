config { default_language = "midnight" }

locals {
  cache_ttl = "1h"

  # The docs' pages, in nav order: each one's path, title, link preview text
  # (description), and its markdown in src/docs (file; "" for the playground,
  # which has its own handler). Scripts get them through kv (see src/pages),
  # for the nav, link previews, and the search index. (a list, not an object:
  # through kv, an object is a lua table w/o an order)
  pages = [
    {
      path        = "/", title = "Introduction", file = "index.md",
      description = "Midnight is a Lua dialect that runs on Go: braces, defaults, destructuring, string interpolation, match, and HTML markup, compiling to plain Lua.",
    },
    {
      path        = "/getting-started", title = "Getting Started", file = "getting-started.md",
      description = "Install the midnight CLI, write a first program, compile to Lua, and embed Midnight in Go programs.",
    },
    {
      path        = "/from-lua", title = "Coming from Lua", file = "from-lua.md",
      description = "What Midnight saves Lua programmers from writing (defaults, catch, match, classes, const, interpolation), and the differences that trip you up.",
    },
    {
      path        = "/markup", title = "Markup", file = "markup.md",
      description = "Server-rendered web apps without the JavaScript toolchain: HTML in the language, components, scoped styles, and interactive pages served by rest.",
    },
    {
      path        = "/reference", title = "Reference", file = "reference.md",
      description = "The whole Midnight language: Lua's features in Midnight's syntax, then what's beyond Lua (match, if expressions, catch, const, classes, and markup).",
    },
    {
      path        = "/tools", title = "Tools", file = "tools.md",
      description = "midnight compile, clean, lint, and fmt: what they do, their rules, and their output.",
    },
    {
      path        = "/playground", title = "Playground", file = "",
      description = "Write and run Midnight in your browser, clickable pages included. Nothing to install.",
    },
  ]


  # a docs page, rendered from its markdown. tmpl only fills in `{{.path}}`,
  # inside a string, so this stays valid midnight (for the editor too); the
  # page itself comes from kv.
  docs_page = <<-MIDNIGHT
    local Layout = require('src/layout')
    local md = require('lib/markdown')
    local page = require('src/pages').find('{{.path}}')
    local doc = md.page("src/docs/{page.file}")
    return <Layout path={page.path} title={page.title} toc={doc.headings}>{doc.blocks}</Layout>
  MIDNIGHT
}

server {
  name      = "midnight-lang.rest"
  address   = ":12000"
  directory = "./public"

  # (what scripts read w/ kv.get, see src/pages)
  kv = {
    pages = locals.pages
  }

  # a handler per docs page (the pages with markdown), from locals.pages
  dynamic "handler" {
    for_each = [for p in locals.pages : p if p.file != ""]
    labels   = ["GET", handler.value.path == "/" ? "/{$}" : handler.value.path]
    content {
      cache = locals.cache_ttl
      page  = tmpl(locals.docs_page, { path = handler.value.path })
    }
  }

  handler "GET" "/playground" {
    cache = locals.cache_ttl
    page  = <<-MIDNIGHT
      local Layout = require('src/layout')
      local Playground = require('src/playground')
      return <Layout path="/playground" title="Playground" wide><Playground/></Layout>
    MIDNIGHT
  }

  # the search index (see src/search and public/js/search.js): built once per
  # cache_ttl, then searched in the browser. (the pages come from kv, so
  # nothing is templated in)
  handler "GET" "/search.json" {
    cache = locals.cache_ttl
    fn    = read("./src/search.mn")
  }
}
