config { default_language = "midnight" }

locals {
  cache_ttl = "1h"
  handler   = <<-MIDNIGHT
    local Layout = require('src/layout')
    local md = require('lib/markdown')
    local doc = md.page('src/docs/{{.file}}')
    return <Layout path="{{.path}}" title="{{.title}}" toc={doc.headings}>{doc.blocks}</Layout>
  MIDNIGHT
}


server {
  name      = "midnight-lang.rest"
  address   = ":12000"
  directory = "./public"

  handler "GET" "/{$}" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/",
      title = "Introduction",
      file  = "index.md"
    })
  }

  handler "GET" "/getting-started" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/getting-started",
      title = "Getting Started",
      file  = "getting-started.md"
    })
  }

  handler "GET" "/reference" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/reference",
      title = "Reference",
      file  = "reference.md"
    })
  }

  handler "GET" "/from-lua" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/from-lua",
      title = "Coming from Lua",
      file  = "from-lua.md"
    })
  }

  handler "GET" "/markup" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/markup",
      title = "Markup",
      file  = "markup.md"
    })
  }

  handler "GET" "/playground" {
    cache = locals.cache_ttl
    page  = <<-MIDNIGHT
      local Layout = require('src/layout')
      local Playground = require('src/playground')
      return <Layout path="/playground" title="Playground" wide><Playground/></Layout>
    MIDNIGHT
  }

  # the search index (see src/search and public/js/search.js): built once per
  # cache_ttl, then searched in the browser
  handler "GET" "/search.json" {
    cache = locals.cache_ttl
    fn = <<-MIDNIGHT
      return {
        status = 200,
        headers = { ["Content-Type"] = "application/json" },
        body = json.encode(require('src/search')()),
      }
    MIDNIGHT
  }

  handler "GET" "/tools" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/tools",
      title = "Tools",
      file  = "tools.md"
    })
  }
}
