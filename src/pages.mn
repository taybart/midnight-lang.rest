-- The docs' pages, in nav order: each one's { path, title, description,
-- file }, where file is its markdown in src/docs (the playground has none).
-- They're `locals.pages` in midnight-lang.rest, handed to scripts through kv,
-- so the list lives in one place, next to the routes.
module map = kv.get('pages') || {}
module list = {}
for _, p in pairs(map) { list[#list + 1] = p }

-- find(path) -> the page at path, or an empty table (so its fields are nil)
module function find(path) {
  for _, p in pairs(list) {
    if p.path == path { return p }
  }
  return {}
}
