-- Meta tag generator
local Meta = require('src/components/meta')
-- constants for vendored deps
local assets = require('src/assets')
-- the nav, and each page's link preview text (see src/pages)
local pages = require('src/pages')
-- where the site lives, for link previews (they need absolute urls)
const SITE_URL = 'https://midnight-lang.rest'

return ({ title, path }) -> <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <Meta
      title={title}
      site="Midnight"
      description={pages.find(path).description}
      url={"{SITE_URL}{path}"}
      image="{SITE_URL}/img/og.png"
      image_alt="midnight: a Lua dialect that runs on Go"
    />
  {--[[ the import map is encoded as JSON, so it's always validated 
         before going to the browser ]]}
    <script type="importmap">
      {{ imports = { ['@taybart/corvid'] = assets.corvid } }}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="stylesheet" href="/site.css"/>
    <script>
      {
        try {
          // try to set the theme, default to dark because its late out
          const t = localStorage.getItem('theme') || 'dark'
          document.documentElement.setAttribute('data-theme', t)
        } catch (e) {}
      }
    </script>
  </head>
