-- Shared layout for the midnight docs: the <html> shell, the sidebar nav, the
-- theme switch, and the favicon. Each page `require`s it and returns
--
--   return <Layout path="/" title="Reference"> ... </Layout>
--
-- The content itself is markdown, rendered by the `lib/markdown` module.
-- The theme is client side: a tiny inline script reads/writes localStorage and
-- sets `data-theme` on <html>, so the choice survives navigation.
local { map, cx } = require('midnight.markup')
local Meta = require('lib/meta')
local Moon = require('lib/components/moon')

-- where the site lives, for link previews (they need absolute urls)
local SITE_URL = 'https://midnight-lang.rest'

-- the nav, and each page's link preview text
local pages = {
  {
    path = '/', title = 'Introduction',
    description = 'Midnight is a Lua dialect that runs on Go: braces, defaults, destructuring, string interpolation, match, and HTML markup, compiling to plain Lua.',
  },
  {
    path = '/getting-started', title = 'Getting Started',
    description = 'Install the midnight CLI, run and compile scripts, and embed Midnight in Go programs.',
  },
  {
    path = '/reference', title = 'Reference',
    description = 'The Midnight language, one feature at a time: strings, tables, destructuring, functions, scopes, operators, match, and if expressions.',
  },
  {
    path = '/from-lua', title = 'Coming from Lua',
    description = 'What changes when you come to Midnight from Lua: !=, symbols for and / or / not, arrow functions, and the Lua 5.1 runtime.',
  },
  {
    path = '/markup', title = 'Markup',
    description = 'HTML-style markup in Midnight: components, state, scoped styles, and interactive pages served by rest.',
  },
  {
    path = '/tools', title = 'Tools',
    description = 'midnight compile, clean, lint, and fmt: what they do, their rules, and their output.',
  },
  {
    path = '/playground', title = 'Playground',
    description = 'Write and run Midnight in your browser, clickable pages included. Nothing to install.',
  },
}

local function pageFor(path) {
  for _, p in ipairs(pages) {
    if p.path == path { return p }
  }
  return {}
}

local Sidebar = ({ path }) -> <>
   <script type="module">
    import {dom, style, ls} from '/js/vendor/corvid.bundle.js'
    {
      const menu = new dom.el('#menu-toggle');
      const sidebar = new dom.el('#sidebar');
      menu.on('click', () => {
        sidebar.toggleClass('open')
        menu.attr('aria-expanded', sidebar.hasClass('open'))
      })

      // auto-hide the mobile top bar: slide out on scroll down, back on up
      let lastY = window.scrollY
      dom.onWindow('scroll', () => {
        const y = window.scrollY
        if (sidebar.hasClass('open')) { lastY = y; return }
        if (y > lastY && y > 96) {
          sidebar.addClass('bar-hidden')
        } else if (y < lastY) {
          sidebar.removeClass('bar-hidden')
        }
        lastY = y
      }, { passive: true })
    }
  </script>
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="/"><Moon/>midnight</a>
    <button class="menu-toggle" id="menu-toggle" title="menu" aria-label="toggle menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
    <nav class="nav" id="nav">
    <ul>
      {map(pages, (p) -> <li>
        <a href={p.path} class={cx({ active = p.path == path })}>{p.title}</a>
      </li>)}
    </ul>
    </nav>
    <button class="theme-toggle" id="theme-toggle" title="toggle theme">
      <span class="icon icon-sun" aria-hidden="true"></span>
      <span class="icon icon-moon" aria-hidden="true"></span>
      <span id="theme-label">dawn</span>
    </button>
  </aside>
</>

return ({ title, path, children, wide }) -> <html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <Meta
      title={title}
      site="Midnight"
      description={pageFor(path).description}
      url={"{SITE_URL}{path}"}
      image="{SITE_URL}/img/og.png"
      imageAlt="midnight: a Lua dialect that runs on Go"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="stylesheet" href="/site.css"/>
    <script>
      {
        try {
          const t = localStorage.getItem('theme') || 'dark'
          document.documentElement.setAttribute('data-theme', t)
        } catch (e) {}
      }
    </script>
  </head>
  <body>
    <div class="layout">
      <Sidebar path={path} />
      <main class={cx("content", { wide = wide })}>{children}</main>
    </div>
    <script type="module">
      import {dom, style, ls, clipboard} from '/js/vendor/corvid.bundle.js'
      {
        // listen to system theme if nothing set
        if (!ls.get('theme')) style.handleThemeSwitch()
        const next = () => style.theme() === 'dark' ? 'light' : 'dark'
        // the themes are dark / light, but the button speaks in hours
        const names = { dark: 'midnight', light: 'dawn' }

        const btn = new dom.el('#theme-toggle');
        const label = new dom.el({
          query: '#theme-label',
          content: names[next()],
        })
        btn.on('click',  () => {
          const nt = next()
          style.theme(nt)
          label.content(names[next()])
          try { ls.set('theme', nt) } catch (e) {}
        })
      }
     </script>
    <script type="module">
      import {dom, style, ls, clipboard} from '/js/vendor/corvid.bundle.js'
      {
        // "Try it" buttons (```midnight try) open the block in the playground
        dom.on('click', async (e) => {
          const btn = e.target.closest('.try-btn')
          if (!btn) return
          const code = btn.closest('.code-block').querySelector('code')
          if (!code) return

          const { playgroundUrl } = await import('/js/play/share.js')
          location.href = await playgroundUrl(code.textContent)
        })
        // copy buttons (opt-in per code block: ```lang copy)
        dom.on('click', (e) => {
          const btn = e.target.closest('.copy-btn')
          if (!btn) return
          const code = btn.closest('.code-block').querySelector('code')
          if (!code) return
          clipboard.copy(code.textContent).then(() => {
            const prev = btn.textContent
            btn.textContent = 'Copied!'
            setTimeout(() => { btn.textContent = prev }, 1500)
          })
        })
      }
    </script>
  </body>
</html>
