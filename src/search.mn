-- The search index, served as GET /search.json (see midnight-lang.rest) and
-- searched in the browser (public/js/search.js). It's every docs page split
-- at its h1 / h2 / h3 headings (see lib/markdown's sections), so each result
-- links straight to its section, with the same ids the rendered page has.
--
-- Each entry: { page, url, title, level, text, code }. page is the page's
-- title, title the section's heading (the page's title for its h1), text the
-- section's prose and code its code blocks, as plain text.
local md = require('lib/markdown')
local pages = require('src/pages').list

local function read(path) {
  local f = assert(io.open(path, 'r'), 'search: cannot open ' .. path)
  local src = f:read('*a')
  f:close()
  return src
}

local entries = {}
for _, page in ipairs(pages) {
  if !page.file || page.file == '' { -- (ex. the playground: just the page, by its description)
    entries[#entries + 1] = {
      page = page.title, url = page.path, title = page.title, level = 1,
      text = page.description, code = '',
    }
    continue
  }
  for i, sec in ipairs(md.sections(read("src/docs/{page.file}"))) {
    local top = i == 1 && sec.level == 1 -- (the page's title, not a part's)
    entries[#entries + 1] = {
      page = page.title,
      url = if top { page.path } else { "{page.path}#{sec.id}" },
      title = if top { page.title } else { sec.title },
      level = sec.level,
      -- (a page's intro also matches its description)
      text = if top { "{page.description} {sec.text}" } else { sec.text },
      code = sec.code,
    }
  }
}

return {
  status = 200,
  headers = { ['Content-Type'] = 'application/json' },
  body = json.encode(entries),
}
