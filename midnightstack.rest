config { default_language = "midnight" }

locals {
  cache_ttl = env("DEV") == "true" ? "1s" : "1h"
  handler   = <<-TMPL
    local Layout = require('src/layout')
    local md = require('lib/markdown')
    return <Layout path="{{.path}}" title="{{.title}}">{md.file('src/docs/{{.file}}')}</Layout>
  TMPL
}


server {
  address   = ":12000"
  directory = "./public"

  handler "GET" "/{$}" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/",
      title = "Introduction",
      file  = "index.md"
    })
  }

  handler "GET" "/getting-started" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/getting-started",
      title = "Getting Started",
      file  = "getting-started.md"
    })
  }

  handler "GET" "/reference" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/reference",
      title = "Reference",
      file  = "reference.md"
    })
  }

  handler "GET" "/from-lua" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/from-lua",
      title = "Coming from Lua",
      file  = "from-lua.md"
    })
  }

  handler "GET" "/markup" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/markup",
      title = "Markup",
      file  = "markup.md"
    })
  }

  handler "GET" "/tools" {
    cache = locals.cache_ttl
    page = tmpl(locals.handler, {
      path  = "/tools",
      title = "Tools",
      file  = "tools.md"
    })
  }
}
