-- highlight.midnight — a tiny syntax highlighter for fenced code blocks.
--
-- midnight and lua are colored by `midnight.syntax`'s highlight (midnight with
-- the compiler's own lexer, so it's colored the way the compiler reads it,
-- markup included), the same classes the playground's editor uses. `sh`,
-- `json`, and `rest` / `hcl` (whose MIDNIGHT heredocs are midnight) have small
-- scanners here. Spans are <span class="tok-*">, and token
-- colors are pure CSS variables (--tok-*), so themes restyle every color in
-- one place — see site.css.
--
-- `highlight(lang, code)` returns a list of children (strings + spans) for the
-- markdown renderer to pass to `h('code', nil, ...)`; strings are escaped by
-- markup as usual. Unsupported (or missing) languages return nil, and the
-- caller falls back to plain escaped text.

local { h } = require('midnight.markup')
local syntax = require('midnight.syntax')


-- token sets -------------------------------------------------------------

local PUNCT = { ['('] = 1, [')'] = 1, ['['] = 1, [']'] = 1, [';'] = 1, [':'] = 1, [','] = 1, ['.'] = 1 }

local SH_KW = {
  ['if'] = 1, ['then'] = 1, ['else'] = 1, ['elif'] = 1, ['fi'] = 1, ['for'] = 1,
  ['do'] = 1, ['done'] = 1, ['while'] = 1, ['until'] = 1, ['case'] = 1, ['esac'] = 1,
  ['in'] = 1, ['function'] = 1, ['select'] = 1, ['return'] = 1, ['export'] = 1,
  ['local'] = 1, ['break'] = 1, ['continue'] = 1,
}

local SH_BUILTIN = {
  ['echo'] = 1, ['cd'] = 1, ['read'] = 1, ['printf'] = 1, ['test'] = 1, ['exit'] = 1,
  ['set'] = 1, ['unset'] = 1, ['shift'] = 1, ['source'] = 1, ['eval'] = 1, ['exec'] = 1,
  ['trap'] = 1, ['wait'] = 1, ['pwd'] = 1, ['type'] = 1, ['command'] = 1, ['builtin'] = 1,
}

-- helpers ----------------------------------------------------------------

local function is_digit(c) { return c:match('%d') != nil }
local function is_hex(c) { return c:match('[%da-fA-F]') != nil }
local function is_ident_start(c) { return c:match('[%a_]') != nil }
local function is_ident_char(c) { return c:match('[%w_]') != nil }

local function text(out, s) { out[#out + 1] = s }

local function span(out, cls, s) {
  out[#out + 1] = h('span', { class = cls }, s)
}

local function scan_number(s, i) {
  local n = #s
  local j = i
  if s:sub(j, j + 1):lower() == '0x' {
    j = j + 2
    while j <= n && is_hex(s:sub(j, j)) { j = j + 1 }
  } elseif s:sub(j, j + 1):lower() == '0b' {
    j = j + 2
    while j <= n && (s:sub(j, j) == '0' || s:sub(j, j) == '1') { j = j + 1 }
  } else {
    while j <= n && is_digit(s:sub(j, j)) { j = j + 1 }
    if j <= n && s:sub(j, j) == '.' && is_digit(s:sub(j + 1, j + 1)) {
      j = j + 1
      while j <= n && is_digit(s:sub(j, j)) { j = j + 1 }
    }
    if j <= n && s:sub(j, j):match('[eE]') {
      local k = j + 1
      if s:sub(k, k) == '+' || s:sub(k, k) == '-' { k = k + 1 }
      if is_digit(s:sub(k, k)) {
        j = k
        while j <= n && is_digit(s:sub(j, j)) { j = j + 1 }
      }
    }
  }
  return j
}

-- midnight / lua ---------------------------------------------------------

-- classed tokens from midnight.syntax (lang: 'midnight' or 'lua'), or nil if
-- the host's midnight predates syntax.highlight (the block is then plain text)
local function scan_code(lang, code) {
  if syntax.highlight == nil { return nil }
  local out = {}
  for _, t in ipairs(syntax.highlight(code, lang)) {
    if t.class != '' { span(out, 'tok-' .. t.class, t.text) } else { text(out, t.text) }
  }
  return out
}

local function scan_midnight(code) { return scan_code('midnight', code) }
local function scan_lua(code) { return scan_code('lua', code) }

-- shell ------------------------------------------------------------------

local function scan_sh(s) {
  local out = {}
  local n = #s
  local i = 1
  while i <= n {
    local c = s:sub(i, i)
    if c == '#' && (i == 1 || s:sub(i - 1, i - 1):match('%s')) {
      local e = s:find('\n', i, true)
      if e == nil {
        span(out, 'tok-comment', s:sub(i))
        i = n + 1
      } else {
        span(out, 'tok-comment', s:sub(i, e - 1))
        i = e
      }
    } elseif c == "'" || c == '"' {
      local q = c
      local j = i + 1
      local buf = { q }
      while j <= n {
        local d = s:sub(j, j)
        if d == '\\' {
          buf[#buf + 1] = s:sub(j, j + 1)
          j = j + 2
        } elseif d == q {
          buf[#buf + 1] = d
          j = j + 1
          break
        } else {
          buf[#buf + 1] = d
          j = j + 1
        }
      }
      span(out, 'tok-string', table.concat(buf))
      i = j
    } elseif c == '$' {
      local j = i + 1
      if s:sub(j, j) == '{' {
        local e = s:find('}', j, true)
        if e == nil {
          span(out, 'tok-builtin', s:sub(i))
          i = n + 1
        } else {
          span(out, 'tok-builtin', s:sub(i, e))
          i = e + 1
        }
      } else {
        while j <= n && s:sub(j, j):match('[%w_]') { j = j + 1 }
        if j == i + 1 { j = j + 1 }
        span(out, 'tok-builtin', s:sub(i, j - 1))
        i = j
      }
    } elseif is_digit(c) {
      local e = scan_number(s, i)
      span(out, 'tok-number', s:sub(i, e - 1))
      i = e
    } elseif is_ident_start(c) {
      local j = i
      while j <= n && is_ident_char(s:sub(j, j)) { j = j + 1 }
      local word = s:sub(i, j - 1)
      if SH_KW[word] {
        span(out, 'tok-keyword', word)
      } elseif SH_BUILTIN[word] {
        span(out, 'tok-builtin', word)
      } else {
        text(out, word)
      }
      i = j
    } else {
      text(out, c)
      i = i + 1
    }
  }
  return out
}

-- json -------------------------------------------------------------------

local function scan_json(s) {
  local out = {}
  local n = #s
  local i = 1
  while i <= n {
    local c = s:sub(i, i)
    if c == '"' {
      local j = i + 1
      local buf = { '"' }
      while j <= n {
        local d = s:sub(j, j)
        if d == '\\' {
          buf[#buf + 1] = s:sub(j, j + 1)
          j = j + 2
        } elseif d == '"' {
          buf[#buf + 1] = d
          j = j + 1
          break
        } else {
          buf[#buf + 1] = d
          j = j + 1
        }
      }
      span(out, 'tok-string', table.concat(buf))
      i = j
    } elseif is_digit(c) || (c == '-' && is_digit(s:sub(i + 1, i + 1))) {
      local start = i
      local e = scan_number(s, i + (if c == '-' { 1 } else { 0 }))
      span(out, 'tok-number', s:sub(start, e - 1))
      i = e
    } elseif is_ident_start(c) {
      local j = i
      while j <= n && is_ident_char(s:sub(j, j)) { j = j + 1 }
      local word = s:sub(i, j - 1)
      if word == 'true' || word == 'false' || word == 'null' {
        span(out, 'tok-const', word)
      } else {
        text(out, word)
      }
      i = j
    } elseif PUNCT[c] {
      span(out, 'tok-punct', c)
      i = i + 1
    } elseif c == '{' || c == '}' {
      span(out, 'tok-punct', c)
      i = i + 1
    } else {
      text(out, c)
      i = i + 1
    }
  }
  return out
}

-- rest (hcl) ---------------------------------------------------------------

-- heredocs with these tags hold code
local HEREDOC_CODE = { MIDNIGHT = scan_midnight, MN = scan_midnight, LUA = scan_lua }

-- an hcl string from i (at its `"`), with`${...}` interpolations
local function hcl_string(s, i, out) {
  local n = #s
  local j = i + 1
  local buf = { '"' }
  while j <= n {
    local d = s:sub(j, j)
    if d == '\\' {
      buf[#buf + 1] = s:sub(j, j + 1)
      j = j + 2
    } elseif d == '"' || d == '\n' {
      if d == '"' { buf[#buf + 1] = d; j = j + 1 }
      break
    } elseif (d == '$' || d == '%') && s:sub(j + 1, j + 1) == '{' {
      local close = s:find('}', j + 2, true)
      if close == nil { buf[#buf + 1] = d; j = j + 1 } else {
        span(out, 'tok-string', table.concat(buf))
        buf = {}
        span(out, 'tok-interp', s:sub(j, j + 1))
        text(out, s:sub(j + 2, close - 1))
        span(out, 'tok-interp', '}')
        j = close + 1
      }
    } else {
      buf[#buf + 1] = d
      j = j + 1
    }
  }
  if #buf > 0 { span(out, 'tok-string', table.concat(buf)) }
  return j
}

local function scan_hcl(s) {
  local out = {}
  local n = #s
  local i = 1
  local line_start = true -- only whitespace since the last newline
  while i <= n {
    local c = s:sub(i, i)
    local start = line_start
    if c != ' ' && c != '\t' { line_start = c == '\n' }

    if c == '#' || s:sub(i, i + 1) == '//' {
      local e = s:find('\n', i, true) || n + 1
      span(out, 'tok-comment', s:sub(i, e - 1))
      i = e
    } elseif s:sub(i, i + 1) == '/*' {
      local e = s:find('*/', i + 2, true)
      e = if e { e + 2 } else { n + 1 }
      span(out, 'tok-comment', s:sub(i, e - 1))
      i = e
    } elseif s:sub(i, i + 1) == '<<' && s:sub(i + 2):match('^%-?[%a_][%w_]*\n') {
      -- heredoc: <<TAG / <<-TAG, up to a line that's just TAG
      local dash, tag = s:sub(i + 2):match('^(%-?)([%a_][%w_]*)')
      local body_start = i + 2 + #dash + #tag + 1
      local close = s:find('\n[ \t]*' .. tag .. '[ \t]*\n', body_start - 1) || s:find('\n[ \t]*' .. tag .. '[ \t]*$', body_start - 1)
      local body_end = if close { close } else { n + 1 }
      span(out, 'tok-operator', '<<' .. dash)
      span(out, 'tok-builtin', tag)
      text(out, '\n')
      local body = s:sub(body_start, body_end - 1)
      local scan = HEREDOC_CODE[tag:upper()]
      local toks = scan && scan(body)
      if toks {
        for _, x in ipairs(toks) { out[#out + 1] = x }
      } else {
        span(out, 'tok-string', body)
      }
      if close {
        local line = s:match('^\n[ \t]*' .. tag, close)
        text(out, line:sub(1, #line - #tag))
        span(out, 'tok-builtin', tag)
        i = close + #line
      } else {
        i = n + 1
      }
    } elseif c == '"' {
      i = hcl_string(s, i, out)
    } elseif is_digit(c) {
      local e = scan_number(s, i)
      span(out, 'tok-number', s:sub(i, e - 1))
      i = e
    } elseif is_ident_start(c) {
      local j = i
      while j <= n && s:sub(j, j):match('[%w_%-]') { j = j + 1 }
      local word = s:sub(i, j - 1)
      local after = s:sub(j):match('^[ \t]*(.)') || ''
      if word == 'true' || word == 'false' || word == 'null' {
        span(out, 'tok-const', word)
      } elseif after == '(' {
        span(out, 'tok-function', word)
      } elseif start && (after == '"' || after == '{') {
        span(out, 'tok-keyword', word) -- a block: `server {`, `handler "GET" "/" {`
      } elseif after == '=' && s:sub(j):match('^[ \t]*=[^=]') {
        span(out, 'tok-attr', word)
      } else {
        text(out, word)
      }
      i = j
    } elseif PUNCT[c] || c == '{' || c == '}' || c == '=' {
      span(out, 'tok-punct', c)
      i = i + 1
    } else {
      text(out, c)
      i = i + 1
    }
  }
  return out
}

-- public -----------------------------------------------------------------

local LANG = {
  midnight = scan_midnight, mn = scan_midnight,
  lua = scan_lua,
  sh = scan_sh, bash = scan_sh, shell = scan_sh, zsh = scan_sh,
  json = scan_json,
  rest = scan_hcl, hcl = scan_hcl,
}

module function highlight(lang, code) {
  if code == nil { return nil }
  local name = if lang { lang } else { '' }
  name = name:gsub('%s.*$', ''):lower()
  local fn = LANG[name] -- (an unlabeled block is plain text)
  if fn == nil { return nil }
  local out = fn(code)
  if out == nil || #out == 0 { return nil }
  return out
}
